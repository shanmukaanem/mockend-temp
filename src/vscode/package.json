{
  "name": "mockend",
  "displayName": "Mockend",
  "description": "Test browser behavior with reusable JSON API mocks in the VS Code Integrated Browser.",
  "publisher": "mockend",
  "license": "SEE LICENSE IN LICENSE",
  "version": "1.5.5",
  "engines": { "vscode": "^1.112.0" },
  "categories": ["Testing"],
  "keywords": ["api", "mock", "http", "testing", "integrated browser"],
  "repository": { "type": "git", "url": "https://github.com/shanmukaanem/mockend-temp.git" },
  "homepage": "https://github.com/shanmukaanem/mockend-temp#readme",
  "bugs": { "url": "https://github.com/shanmukaanem/mockend-temp/issues" },
  "icon": "icons/128.png",
  "main": "./vscode/extension.cjs",
  "files": ["vscode/*.cjs", "vscode/*.mjs", "core/*", "ui/*", "chromium/*", "icons/*", "panel.html", "README.md", "CHANGELOG.md", "PRIVACY.md", "LICENSE"],
  "extensionKind": ["ui"],
  "capabilities": {
    "virtualWorkspaces": { "supported": false },
    "untrustedWorkspaces": { "supported": false }
  },
  "contributes": {
    "commands": [
      { "command": "mockend.open", "title": "Mockend: Open" },
      { "command": "mockend.stop", "title": "Mockend: Stop Mocking" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "mockend", "title": "Mockend", "icon": "icons/activity.png" }]
    },
    "views": {
      "mockend": [{ "type": "webview", "id": "mockend.control", "name": "API Testing" }]
    }
  }
}
